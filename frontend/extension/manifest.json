{
  "manifest_version": 3,
  "name": "PrivacyLens — Privacy Policy Analyzer",
  "version": "2.1.0",
  "description": "Instantly scan any website's privacy policy and see its risk score, flagged issues, and dark patterns.",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "https://privacy-risk-analyzer.vercel.app/*"
      ],
      "js": ["announce.js"],
      "run_at": "document_start"
    }
  ],

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "https://privacy-risk-analyzer.vercel.app/*"
    ]
  }
}