# Copy this file to ".env" in this same folder and fill in real values.

# Where your backend (from the /backend folder) is running
VITE_API_URL=http://127.0.0.1:8811

# Firebase — console.firebase.google.com -> Project Settings -> General
# -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
