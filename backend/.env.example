# Copy this file to ".env" in this same folder and fill in real values.

# Groq — console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=

# MongoDB Atlas — cloud.mongodb.com -> Connect -> Drivers -> copy connection string
MONGODB_URI=
DATABASE_NAME=privacylens

# Firebase — console.firebase.google.com -> Project Settings -> Service accounts
# -> Generate new private key. Open the downloaded JSON file, and paste its
# ENTIRE contents here on a single line (no line breaks).
FIREBASE_CREDENTIALS=

# Admin dashboard — separate from Firebase, single hardcoded operator
# account. Only safe locally (127.0.0.1) — change before any public deploy.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=change-me-to-a-random-string
